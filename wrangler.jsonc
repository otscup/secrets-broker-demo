{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "secrets-broker-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "DEMO_STATE", "class_name": "DemoState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DemoState"] }
  ]
}

